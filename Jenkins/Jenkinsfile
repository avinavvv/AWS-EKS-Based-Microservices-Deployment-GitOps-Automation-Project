
@Library('Shared') _

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 90, unit: 'MINUTES')
    }

    environment {
        REPOSITORY_URL = 'https://github.com/avinavvv/AWS-EKS-Based-Microservices-Deployment-GitOps-Automation-Project.git'
        GIT_BRANCH = 'main'
        DOCKERHUB_CREDENTIALS = 'dockerhub-creds'
        IMAGE_TAG_LENGTH = '12'
        TRIVY_SEVERITIES = 'HIGH,CRITICAL'
        TRIVY_EXIT_CODE = '0'
    }

    stages {

        stage('Workspace Cleanup') {
            steps {
                deleteDir()
            }
        }

        stage('Git: Code Checkout') {
            steps {
                codeCheckout(
                    env.REPOSITORY_URL,
                    env.GIT_BRANCH
                )
            }
        }

        stage('Discover Microservices') {
            steps {
                discoverServices(env.IMAGE_TAG_LENGTH)
            }
        }

        stage('Trivy: Filesystem Scan') {
            steps {
                trivyFilesystem(
                    env.TRIVY_SEVERITIES,
                    env.TRIVY_EXIT_CODE
                )
            }
        }

        stage('Docker: Build All Microservices') {
            steps {
                dockerBuildAll(
                    env.DOCKERHUB_CREDENTIALS
                )
            }
        }

        stage('Trivy: Image Scan') {
            steps {
                trivyImageScan(
                    env.DOCKERHUB_CREDENTIALS,
                    env.TRIVY_SEVERITIES,
                    env.TRIVY_EXIT_CODE
                )
            }
        }

        stage('Docker: Push to Docker Hub') {
            steps {
                dockerPushAll(
                    env.DOCKERHUB_CREDENTIALS
                )
            }
        }

        stage('Docker: Cleanup') {
            steps {
                dockerCleanupAll(env.DOCKERHUB_CREDENTIALS)
            }
        }
    }

    post {

        always {
            echo 'CI pipeline execution completed.'
        }

        success {
            echo 'All microservices built, scanned and pushed successfully.'
        }

        failure {
            echo 'Pipeline failed. Running Docker cleanup.'

            script {
                dockerCleanupAll(env.DOCKERHUB_CREDENTIALS)
            }
        }

        aborted {
            echo 'Pipeline aborted. Running Docker cleanup.'

            script {
                dockerCleanupAll(env.DOCKERHUB_CREDENTIALS)
            }
        }
    }
}
