
@Library('Shared') _

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 90, unit: 'MINUTES')
    }

    environment {
        REPOSITORY_URL = 'https://github.com/avinavvv/AWS-EKS-Based-Microservices-Deployment-GitOps-Automation-Project.git'
        GIT_BRANCH = 'main'
        DOCKERHUB_CREDENTIALS = 'dockerhub-creds'
        IMAGE_TAG_LENGTH = '12'
        TRIVY_SEVERITIES = 'HIGH,CRITICAL'
        TRIVY_EXIT_CODE = '0'
    }

    stages {

        stage('Workspace Cleanup') {
            steps {
                deleteDir()
            }
        }

        stage('Git: Code Checkout') {
            steps {
                codeCheckout(
                    env.REPOSITORY_URL,
                    env.GIT_BRANCH
                )
            }
        }

        stage('Discover Microservices') {
            steps {
                discoverServices(env.IMAGE_TAG_LENGTH)
            }
        }

        stage('Trivy: Filesystem Scan') {
            when {
                expression {
                    env.RUN_CI == 'true'
                }
            }
            steps {
                trivyFilesystem(
                    env.TRIVY_SEVERITIES,
                    env.TRIVY_EXIT_CODE
                )
            }
        }

        stage('Docker: Wait for Daemon') {
            when {
                expression {
                    env.RUN_CI == 'true' && env.SERVICES?.trim()
                }
            }
            steps {
                waitForDocker()
            }
        }

        stage('Docker: Build Selected Microservices') {
            when {
                expression {
                    env.RUN_CI == 'true' && env.SERVICES?.trim()
                }
            }
            steps {
                dockerBuildAll(
                    env.DOCKERHUB_CREDENTIALS
                )
            }
        }

        stage('Trivy: Image Scan') {
            when {
                expression {
                    env.RUN_CI == 'true' && env.SERVICES?.trim()
                }
            }
            steps {
                trivyImageScan(
                    env.DOCKERHUB_CREDENTIALS,
                    env.TRIVY_SEVERITIES,
                    env.TRIVY_EXIT_CODE
                )
            }
        }

        stage('Docker: Push to Docker Hub') {
            when {
                expression {
                    env.RUN_CI == 'true' && env.SERVICES?.trim()
                }
            }
            steps {
                dockerPushAll(
                    env.DOCKERHUB_CREDENTIALS
                )
            }
        }

        stage('Docker: Cleanup') {
            when {
                expression {
                    env.RUN_CI == 'true' && env.SERVICES?.trim()
                }
            }
            steps {
                dockerCleanupAll(
                    env.DOCKERHUB_CREDENTIALS
                )
            }
        }
    }

    post {

        always {
            echo 'CI pipeline execution completed.'
        }

        success {
            script {
                if (env.RUN_CI == 'true') {
                    echo "CI pipeline completed successfully. Image tag: ${env.IMAGE_TAG}"
                } else {
                    echo 'CI pipeline skipped: No changes detected inside src/.'
                }
            }
        }

        failure {
            echo 'Pipeline failed. Checking whether Docker cleanup is required.'

            script {
                if (env.RUN_CI == 'true' && env.SERVICES?.trim()) {
                    dockerCleanupAll(env.DOCKERHUB_CREDENTIALS)
                }
            }
        }

        aborted {
            echo 'Pipeline aborted.'

            script {
                if (env.RUN_CI == 'true' && env.SERVICES?.trim()) {
                    dockerCleanupAll(env.DOCKERHUB_CREDENTIALS)
                }
            }
        }
    }
}

