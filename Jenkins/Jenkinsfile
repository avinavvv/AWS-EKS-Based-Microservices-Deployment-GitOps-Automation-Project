
@Library('Shared') _

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 90, unit: 'MINUTES')
    }

    environment {
        REPOSITORY_URL = 'https://github.com/avinavvv/AWS-EKS-Based-Microservices-Deployment-GitOps-Automation-Project.git'
        GIT_BRANCH = 'main'
        DOCKERHUB_CREDENTIALS = 'dockerhub-creds'
        IMAGE_TAG_LENGTH = '12'
        TRIVY_SEVERITIES = 'HIGH,CRITICAL'
        TRIVY_EXIT_CODE = '0'
    }

    stages {

        stage('Workspace Cleanup') {
            steps {
                deleteDir()
            }
        }

        stage('Git: Code Checkout') {
            steps {
                codeCheckout(
                    env.REPOSITORY_URL,
                    env.GIT_BRANCH
                )
            }
        }

        stage('Discover Microservices') {
            steps {
                discoverServices(env.IMAGE_TAG_LENGTH)
            }
        }

        stage('Trivy: Filesystem Scan') {
            steps {
                trivyFilesystem(
                    env.TRIVY_SEVERITIES,
                    env.TRIVY_EXIT_CODE
                )
            }
        }

        stage('Docker: Build, Scan and Push') {
            steps {
                dockerBuildScanPushAll(
                    env.DOCKERHUB_CREDENTIALS,
                    env.TRIVY_SEVERITIES,
                    env.TRIVY_EXIT_CODE
                )
            }
        }
    }

    post {
        always {
            echo 'CI pipeline completed. Review stage logs and reports.'
        }

        success {
            echo 'All microservices processed and images pushed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage logs.'
        }

        aborted {
            echo 'Pipeline was aborted.'
        }
    }
}
